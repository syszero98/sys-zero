# Flask Configuration
FLASK_ENV=development
FLASK_APP=backend/app.py
FLASK_DEBUG=True

# Admin Settings
ADMIN_PASSCODE=mutapetsarakpelet

# Database
DATABASE_PATH=backend/data/database.json

# Server
HOST=0.0.0.0
PORT=5000

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Upload Settings
MAX_FILE_SIZE=16777216
UPLOAD_FOLDER=backend/data/uploads

# Excel Parser
SAMPLE_TEMPLATE_PATH=sample_template.xlsx
